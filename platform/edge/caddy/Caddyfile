{
	admin off
	servers {
		metrics
	}
}

:80 {
	encode zstd gzip

	# SSE-поток уведомлений идёт напрямую, без Envoy и gRPC-транскодера.
	handle_path /api/notifications/* {
		reverse_proxy notifications:8080
	}

	# /api/* -> envoy, префикс /api срезается (в proto-аннотациях пути без него)
	handle_path /api/* {
		reverse_proxy envoy:8080
	}

	handle {
 	    reverse_proxy frontend:3000
	}
}

:9180 {
	metrics
}
