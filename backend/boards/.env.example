DATABASE_URL=postgresql://root:root@localhost:5432/boards
USERS_GRPC_ADDR=dns:///localhost:9091

ENV=dev
LOG_LEVEL=info
LOG_FORMAT=text
HTTP_PORT=8081
GRPC_PORT=9092
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# сколько секунд профиль пользователя живёт в кеше, 0 отключает кеш (бан доходит до форума не позже этого срока)
USERS_CACHE_TTL=1m
